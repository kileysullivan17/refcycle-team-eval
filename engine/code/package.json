{
  "name": "refcycle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --import tsx src/main.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "eval": "node --import tsx src/evaluate.ts",
    "smoke": "node --import tsx src/smoke.ts",
    "test:live": "node --import tsx src/behavior-eval.ts",
    "test:ui": "node --import tsx test/ui.mjs"
  },
  "dependencies": {
    "yaml": "https://registry.npmjs.org/yaml/-/yaml-2.9.0.tgz",
    "zod": "https://registry.npmjs.org/zod/-/zod-4.1.11.tgz"
  },
  "devDependencies": {
    "@types/node": "https://registry.npmjs.org/@types/node/-/node-22.19.19.tgz",
    "csv-parse": "https://registry.npmjs.org/csv-parse/-/csv-parse-7.0.3.tgz",
    "playwright-core": "https://registry.npmjs.org/playwright-core/-/playwright-core-1.64.1.tgz",
    "tsx": "https://registry.npmjs.org/tsx/-/tsx-4.21.0.tgz",
    "typescript": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz"
  }
}
